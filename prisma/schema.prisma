generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  /* Relative to this schema file — resolves to <project>/db/custom.db.
     No DATABASE_URL env var is needed; run `bun run db:push` to create it. */
  url      = "file:../db/custom.db"
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organisation String?
  enquiryType  String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}
